# ==============================================================================
# Tattva AI Film Director - Environment Configuration Example
# Copy to .env and configure for your local or staging environment.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1

# Authentication (ADR-003; docs/audit/11_APPROVAL_GATE_DECISIONS.md gate 1)
# -----------------------------------------------------------------------------
# environment=development: SECRET_KEY signs/verifies this server's own dev-issued
# tokens (POST /api/v1/auth/dev-login). Required and non-empty, or every request
# fails closed with a 500. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600

# environment=staging|production: an external identity provider verifies tokens.
# DEC-002 chose Supabase Auth (AUTH_PROVIDER=supabase, the default). Set SUPABASE_URL
# to the project URL; issuer, JWKS URL and audience are derived from it. The project
# must use asymmetric JWT signing keys (ES256 or RS256); legacy HS256 secrets are not
# accepted. Without SUPABASE_URL every request fails closed with a 500.
AUTH_PROVIDER=supabase
SUPABASE_URL=
# Only for AUTH_PROVIDER=oidc (any other standards-compliant provider). All three together.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

# Streamlit UI Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_API_BASE_URL=http://localhost:8000/api/v1

# Canonical Database (PostgreSQL + pgvector)
# Dedicated Tattva database connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/tattva_film_director
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# LangGraph PostgreSQL Checkpoint Settings
# Isolated schema for execution state checkpointing
CHECKPOINT_SCHEMA=langgraph_checkpoints

# Private Object Storage
# Local filesystem storage provider is default for local development
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_MAX_UPLOAD_BYTES=104857600  # 100MB
STORAGE_ALLOWED_MIME_TYPES=text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/json

# AI Model Gateway (C10; packages/ai/gateway.py)
# "deterministic" wraps the 4 existing rule-based generators behind a validated,
# typed ModelGateway interface -- real logic, not a placeholder, just not an LLM call yet.
MODEL_GATEWAY_PROVIDER=deterministic
# Optional API keys for cloud providers (unconfigured by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# External Video Generation (Higgsfield)
# Higgsfield is external. Default is mock / manual export mode.
HIGGSFIELD_INTEGRATION_MODE=manual_export
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_API_KEY=

# Worker / Job Dispatch
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=4
