# ==============================================================================
# Tattva AI Film Director - Environment Configuration Example
# Copy to .env and configure for your local or staging environment.
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-bytes-min

# Streamlit UI Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_API_BASE_URL=http://localhost:8000/api/v1

# Canonical Database (PostgreSQL + pgvector)
# Dedicated Tattva database connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/tattva_film_director
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# LangGraph PostgreSQL Checkpoint Settings
# Isolated schema for execution state checkpointing
CHECKPOINT_SCHEMA=langgraph_checkpoints

# Private Object Storage
# Local filesystem storage provider is default for local development
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_MAX_UPLOAD_BYTES=104857600  # 100MB
STORAGE_ALLOWED_MIME_TYPES=text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/json

# AI Model Gateway
# Default is mock mode for deterministic offline testing and vertical slice validation
MODEL_GATEWAY_PROVIDER=mock
# Optional API keys for cloud providers (unconfigured by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# External Video Generation (Higgsfield)
# Higgsfield is external. Default is mock / manual export mode.
HIGGSFIELD_INTEGRATION_MODE=manual_export
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai
HIGGSFIELD_API_KEY=

# Worker / Job Dispatch
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=4
